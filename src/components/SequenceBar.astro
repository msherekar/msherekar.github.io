---
// Real sequence segment from 6CU2 chain A (pyocin tail fiber)
// Tinted by Kyte-Doolittle hydrophobicity scale
const seq = "MSDKQTFQAILNNAPNAATANVLQNWSSGVTYGGGMAGTKTANAIASTGKLQWNTDSGVTYGGGMAGTKTANAIASTGKLQWNTDSGVTYG";
const hydro: Record<string,number> = {
  A:1.8,R:-4.5,N:-3.5,D:-3.5,C:2.5,Q:-3.5,E:-3.5,G:-0.4,H:-3.2,I:4.5,
  L:3.8,K:-3.9,M:1.9,F:2.8,P:-1.6,S:-0.8,T:-0.7,W:-0.9,Y:-1.3,V:4.2
};
function color(aa: string): string {
  const h = hydro[aa.toUpperCase()] ?? 0;
  const t = (h + 4.5) / 9; // normalize 0–1
  if (t > 0.6) return `rgba(249,115,22,${0.5+t*0.5})`; // hydrophobic → orange
  if (t < 0.35) return `rgba(59,130,246,${0.4+t})`; // hydrophilic → blue
  return `rgba(34,197,94,${0.45+t*0.4})`; // neutral → green
}
---
<div class="seq-bar" aria-label="Protein sequence of 6CU2 colored by hydrophobicity">
  {seq.split('').map((aa, i) => (
    <span class="aa" style={`color:${color(aa)}`} title={`${aa}${i+1}`}>{aa}</span>
  ))}
  <span class="seq-ellipsis">…</span>
</div>

<style>
  .seq-bar {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem; letter-spacing: 0.08em;
    line-height: 1.8; word-break: break-all;
    opacity: 0.75; user-select: none;
    margin: 1.5rem 0 0;
  }
  .aa { transition: opacity 0.2s; }
  .aa:hover { opacity: 0.5; }
  .seq-ellipsis { color: var(--text-3); }
</style>
