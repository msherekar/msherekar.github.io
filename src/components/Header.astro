---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/publications', label: 'Publications' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname;
---
<header id="site-header">
  <nav class="container">
    <a href="/" class="logo" aria-label="Mukul Sherekar — home">
      <span class="logo-letters grad-text">MS</span>
    </a>
    <ul class="nav-links" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class:list={['nav-link', { active: current === href || (href !== '/' && current.startsWith(href)) }]}>
            {label}
          </a>
        </li>
      ))}
      <li>
        <a href="/assets/documents/Bioinformatics_07262025.pdf" target="_blank" rel="noopener" class="nav-cta">
          CV
        </a>
      </li>
    </ul>
    <button class="hamburger" id="hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Navigation">
  {navLinks.map(({ href, label }) => (
    <a href={href} class="mobile-link">{label}</a>
  ))}
  <a href="/assets/documents/Bioinformatics_07262025.pdf" target="_blank" rel="noopener" class="mobile-link mobile-cta">Download CV</a>
</div>

<style>
  header {
    position: fixed; top: 0; width: 100%; z-index: 900;
    background: rgba(12, 17, 32, 0.88);
    backdrop-filter: blur(20px) saturate(1.3);
    border-bottom: 1px solid var(--border);
    transition: background 0.3s ease;
  }
  header.scrolled { background: rgba(12, 17, 32, 0.97); }

  nav {
    display: flex; justify-content: space-between; align-items: center;
    height: 64px;
  }

  .logo-letters {
    font-size: 1.35rem; font-weight: 900; letter-spacing: -0.04em;
  }

  .nav-links {
    display: flex; list-style: none; align-items: center; gap: 0.2rem;
  }
  .nav-link {
    padding: 0.45rem 0.85rem; border-radius: var(--radius-sm);
    font-size: 0.87rem; font-weight: 500; color: var(--text-2);
    transition: color 0.2s, background 0.2s;
  }
  .nav-link:hover, .nav-link.active { color: var(--text); background: rgba(255,255,255,0.05); }
  .nav-cta {
    padding: 0.42rem 1.1rem; border-radius: 8px;
    font-size: 0.87rem; font-weight: 600;
    background: var(--grad-nc); color: #fff;
    transition: opacity 0.2s, transform 0.2s;
  }
  .nav-cta:hover { opacity: 0.88; transform: translateY(-1px); }

  /* Hamburger */
  .hamburger { display: none; flex-direction: column; gap: 5px; padding: 6px; }
  .hamburger span {
    display: block; width: 22px; height: 2px;
    background: var(--text); border-radius: 2px;
    transition: all 0.28s ease;
  }
  .hamburger[aria-expanded="true"] span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded="true"] span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

  /* Mobile menu */
  .mobile-menu {
    display: none; position: fixed; inset: 0; z-index: 850;
    background: rgba(12,17,32,0.98); backdrop-filter: blur(20px);
    flex-direction: column; justify-content: center; align-items: center; gap: 1.4rem;
  }
  .mobile-menu.open { display: flex; }
  .mobile-link {
    font-size: 1.35rem; font-weight: 600; color: var(--text);
    padding: 0.5rem 1.5rem; border-radius: 10px;
    transition: background 0.2s;
  }
  .mobile-link:hover { background: rgba(255,255,255,0.05); }
  .mobile-cta {
    margin-top: 0.5rem; font-size: 1rem;
    background: var(--grad-nc); color: #fff !important;
    padding: 0.7rem 2rem;
  }

  @media (max-width: 700px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger')!;
  const menu = document.getElementById('mobile-menu')!;
  const header = document.getElementById('site-header')!;

  function toggleMenu(open?: boolean) {
    const next = open ?? hamburger.getAttribute('aria-expanded') !== 'true';
    hamburger.setAttribute('aria-expanded', String(next));
    menu.classList.toggle('open', next);
    document.body.style.overflow = next ? 'hidden' : '';
  }

  hamburger.addEventListener('click', () => toggleMenu());
  hamburger.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleMenu(); }
  });
  menu.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => toggleMenu(false))
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') toggleMenu(false);
  });

  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 50);
  }, { passive: true });
</script>
